---
import type { Locale } from '../../i18n/locales';
import { ui } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dictionary = ui[locale].mode;
---

<button class="mode-toggle" type="button" data-mode-toggle aria-pressed="false">
  <span class="mode-toggle__track" aria-hidden="true">
    <span class="mode-toggle__thumb"></span>
  </span>
  <span class="mode-toggle__label">{dictionary.toggleLabel}</span>
</button>

<style>
  .mode-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0;
    border: 0;
    background: none;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    cursor: pointer;
  }

  :global(html:not([data-mode])) .mode-toggle,
  .mode-toggle:disabled {
    display: none;
  }

  .mode-toggle__track {
    display: inline-flex;
    align-items: center;
    width: 2.1rem;
    height: 1.15rem;
    padding: 2px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    transition: border-color var(--transition);
  }

  .mode-toggle__thumb {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-muted);
    transition:
      transform var(--transition),
      background-color var(--transition);
  }

  .mode-toggle[aria-pressed='true'] {
    color: var(--color-text);
  }

  .mode-toggle[aria-pressed='true'] .mode-toggle__track {
    border-color: var(--color-accent);
  }

  .mode-toggle[aria-pressed='true'] .mode-toggle__thumb {
    background: var(--color-accent);
    transform: translateX(0.9rem);
  }

  @media (max-width: 30rem) {
    .mode-toggle__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
</style>
