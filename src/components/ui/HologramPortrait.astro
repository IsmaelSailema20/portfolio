---
import { joinBasePath } from '../../i18n/paths';

interface Props {
  source: string;
  name: string;
  description: string;
}

const { source, name, description } = Astro.props;
---

<figure class="hologram-portrait">
  <div class="hologram-portrait__frame">
    <img
      class="hologram-portrait__image"
      src={joinBasePath(import.meta.env.BASE_URL, source)}
      alt={description}
      width="400"
      height="500"
      loading="lazy"
      decoding="async"
    />
    <span class="hologram-portrait__scan" aria-hidden="true"></span>
  </div>
  <span class="hologram-portrait__beam" aria-hidden="true"></span>
  <span class="hologram-portrait__emitter" aria-hidden="true"></span>
  <figcaption class="label hologram-portrait__caption">{name}</figcaption>
</figure>

<style>
  .hologram-portrait {
    position: relative;
    display: grid;
    justify-items: center;
    width: min(100%, 17rem);
    margin: 0;
  }

  .hologram-portrait__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 50% 50% var(--radius) var(--radius) / 40% 40% var(--radius) var(--radius);
    box-shadow:
      0 0 0 1px rgb(111 214 232 / 0.3),
      0 0 48px rgb(111 214 232 / 0.18);
    mask-image: linear-gradient(to bottom, #000 72%, transparent 99%);
  }

  .hologram-portrait__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hologram-portrait__frame::before,
  .hologram-portrait__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .hologram-portrait__frame::before {
    background: repeating-linear-gradient(
      to bottom,
      rgb(7 11 20 / 0.22) 0 1px,
      transparent 1px 4px
    );
  }

  .hologram-portrait__frame::after {
    background: radial-gradient(ellipse at 50% 40%, transparent 55%, rgb(7 11 20 / 0.55));
  }

  .hologram-portrait__scan {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    z-index: 2;
    height: 18%;
    background: linear-gradient(to bottom, transparent, rgb(236 231 223 / 0.22), transparent);
    opacity: 0;
  }

  .hologram-portrait__beam {
    width: 70%;
    height: 2.2rem;
    margin-top: -1.6rem;
    background: linear-gradient(to top, rgb(111 214 232 / 0.35), transparent);
    clip-path: polygon(30% 100%, 70% 100%, 100% 0, 0 0);
  }

  .hologram-portrait__emitter {
    width: 55%;
    height: 0.6rem;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, var(--color-interactive), transparent 70%);
    box-shadow: 0 0 24px rgb(111 214 232 / 0.45);
  }

  .hologram-portrait__caption {
    margin-top: var(--space-1);
    color: var(--color-interactive);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hologram-portrait__frame {
      animation: portrait-flicker 7s steps(1, end) infinite;
    }

    .hologram-portrait__scan {
      animation: portrait-scan 4.5s linear infinite;
    }
  }

  @keyframes portrait-flicker {
    0%,
    100% {
      opacity: 0.92;
    }
    88% {
      opacity: 0.6;
    }
    89% {
      opacity: 0.92;
    }
    91% {
      opacity: 0.75;
      transform: translateX(1px);
    }
    92% {
      opacity: 0.92;
      transform: none;
    }
  }

  @keyframes portrait-scan {
    from {
      opacity: 1;
      transform: translateY(-100%);
    }
    to {
      opacity: 1;
      transform: translateY(560%);
    }
  }
</style>
