---
import type { CollectionEntry } from 'astro:content';
import SectionShell from '../ui/SectionShell.astro';
import TechHologram from '../ui/TechHologram.astro';
import { localize, type Locale } from '../../i18n/locales';

interface Props {
  locale: Locale;
  skillGroups: CollectionEntry<'skills'>[];
}

const { locale, skillGroups } = Astro.props;
---

<SectionShell
  stageId="skills"
  locale={locale}
  side="left"
  itemCount={skillGroups.length}
  stepCount={skillGroups.length}
>
  <ul class="skill-groups">
    {
      skillGroups.map((skillGroup) => (
        <li class="skill-group" data-step>
          <div class="skill-group__heading">
            <p class="skill-group__name">{localize(skillGroup.data.name, locale)}</p>
            <p class="skill-group__description">{localize(skillGroup.data.description, locale)}</p>
          </div>
          <ul class="hologram-deck">
            {skillGroup.data.items.map((item, itemIndex) => (
              <TechHologram technology={item} index={itemIndex} />
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</SectionShell>

<style>
  .skill-groups {
    display: grid;
    gap: var(--space-4);
  }

  .skill-group {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line);
  }

  .skill-group__heading {
    display: grid;
    gap: 0.35rem;
    max-width: 46ch;
  }

  .skill-group__name {
    font-size: 1.35rem;
    font-weight: 600;
  }

  .skill-group__description {
    color: var(--color-muted);
  }

  .hologram-deck {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-1);
    padding: var(--space-2) var(--space-2) var(--space-1);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background:
      radial-gradient(ellipse 70% 60% at 50% 100%, rgb(111 214 232 / 0.08), transparent),
      linear-gradient(rgb(111 214 232 / 0.05) 1px, transparent 1px) 0 0 / 100% 12px;
  }

  @container (min-width: 52rem) {
    .skill-group {
      grid-template-columns: 17rem 1fr;
      align-items: center;
    }
  }
</style>
