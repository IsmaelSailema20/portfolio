---
import type { CollectionEntry } from 'astro:content';
import SectionShell from '../ui/SectionShell.astro';
import { localize, type Locale } from '../../i18n/locales';
import { joinBasePath } from '../../i18n/paths';
import { ui } from '../../i18n/ui';

interface Props {
  locale: Locale;
  profile: CollectionEntry<'profile'>['data'];
}

const { locale, profile } = Astro.props;
const dictionary = ui[locale].contact;
const curriculumPath = joinBasePath(import.meta.env.BASE_URL, localize(profile.curriculum, locale));
---

<SectionShell stageId="contact" locale={locale} side="left">
  <p class="contact__lead">{dictionary.lead}</p>
  <ul class="contact__links">
    <li>
      <span class="label">{dictionary.email}</span>
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </li>
    {
      profile.links.map((link) => (
        <li>
          <span class="label">{link.label}</span>
          <a href={link.url} rel="me noopener" data-warp-link>
            {link.url.replace(/^https?:\/\/(www\.)?/, '')}
          </a>
        </li>
      ))
    }
  </ul>
  <form class="contact-form" data-contact-form data-recipient={profile.email}>
    <h3 class="label label--accent">{dictionary.formTitle}</h3>
    <label class="contact-form__field">
      <span class="label">{dictionary.nameLabel}</span>
      <input type="text" name="name" autocomplete="name" required />
    </label>
    <label class="contact-form__field">
      <span class="label">{dictionary.subjectLabel}</span>
      <input type="text" name="subject" required />
    </label>
    <label class="contact-form__field">
      <span class="label">{dictionary.messageLabel}</span>
      <textarea name="message" rows="5" required></textarea>
    </label>
    <div class="contact-form__footer">
      <button class="button" type="submit" data-magnetic>{dictionary.send} →</button>
      <p class="contact-form__hint">{dictionary.formHint}</p>
    </div>
  </form>
  <div class="contact__actions">
    <a class="button" href={curriculumPath} download data-curriculum-link data-magnetic>
      {dictionary.downloadCurriculum} ↓
    </a>
    <button class="button button--quiet" type="button" data-wormhole-jump data-magnetic>
      <span class="only-immersive">{dictionary.crossWormhole} →</span>
      <span class="only-classic">{dictionary.backToStart} ↑</span>
    </button>
  </div>
</SectionShell>

<style>
  .contact__lead {
    max-width: 40ch;
    font-size: var(--text-lead);
    color: var(--color-muted);
  }

  .contact__links {
    display: grid;
    margin-block: var(--space-3);
    max-width: 36rem;
  }

  .contact__links li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-2);
    border-top: 1px solid var(--color-line);
  }

  .contact-form {
    display: grid;
    gap: var(--space-2);
    max-width: 36rem;
    margin-bottom: var(--space-3);
  }

  .contact-form__field {
    display: grid;
    gap: 0.4rem;
  }

  .contact-form__field input,
  .contact-form__field textarea {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    transition: border-color var(--transition);
  }

  .contact-form__field textarea {
    resize: vertical;
  }

  .contact-form__field input:hover,
  .contact-form__field textarea:hover,
  .contact-form__field input:focus,
  .contact-form__field textarea:focus {
    border-color: var(--color-accent);
  }

  .contact-form__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .contact-form__hint {
    max-width: 30ch;
    font-size: var(--text-small);
    color: var(--color-muted);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
