---
import type { CollectionEntry } from 'astro:content';
import SectionShell from '../ui/SectionShell.astro';
import { localize, type Locale } from '../../i18n/locales';
import { joinBasePath } from '../../i18n/paths';
import { ui } from '../../i18n/ui';

interface Props {
  locale: Locale;
  profile: CollectionEntry<'profile'>['data'];
}

const { locale, profile } = Astro.props;
const dictionary = ui[locale].contact;
const curriculumPath = joinBasePath(import.meta.env.BASE_URL, localize(profile.curriculum, locale));
---

<SectionShell stageId="contact" locale={locale} side="left">
  <p class="contact__lead">{dictionary.lead}</p>
  <ul class="contact__links">
    <li>
      <span class="label">{dictionary.email}</span>
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </li>
    {
      profile.links.map((link) => (
        <li>
          <span class="label">{link.label}</span>
          <a href={link.url} rel="me noopener" data-warp-link>
            {link.url.replace(/^https?:\/\/(www\.)?/, '')}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="contact__actions">
    <a class="button" href={curriculumPath} download data-curriculum-link data-magnetic>
      {dictionary.downloadCurriculum} ↓
    </a>
    <button class="button button--quiet" type="button" data-wormhole-jump data-magnetic>
      <span class="only-immersive">{dictionary.crossWormhole} →</span>
      <span class="only-classic">{dictionary.backToStart} ↑</span>
    </button>
  </div>
</SectionShell>

<style>
  .contact__lead {
    max-width: 40ch;
    font-size: var(--text-lead);
    color: var(--color-muted);
  }

  .contact__links {
    display: grid;
    margin-block: var(--space-3);
    max-width: 36rem;
  }

  .contact__links li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-2);
    border-top: 1px solid var(--color-line);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
