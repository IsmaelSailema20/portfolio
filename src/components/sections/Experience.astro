---
import type { CollectionEntry } from 'astro:content';
import DetailToggle from '../ui/DetailToggle.astro';
import SectionShell from '../ui/SectionShell.astro';
import TechHologram from '../ui/TechHologram.astro';
import { formatPeriod } from '../../i18n/formatPeriod';
import { localize, type Locale } from '../../i18n/locales';
import { ui } from '../../i18n/ui';

interface Props {
  locale: Locale;
  experiences: CollectionEntry<'experience'>[];
}

const { locale, experiences } = Astro.props;
const dictionary = ui[locale].experience;
---

<SectionShell
  stageId="experience"
  locale={locale}
  side="right"
  itemCount={experiences.length}
  stepCount={experiences.length}
>
  <ol class="experience-list">
    {
      experiences.map(({ data: experience }) => (
        <li class="experience" data-step>
          <p class="label">
            {formatPeriod(experience.start, experience.end, locale, dictionary.present)}
          </p>
          <div class="experience__body">
            <h3 class="experience__role">
              {localize(experience.role, locale)}
              <span class="experience__company">{experience.company}</span>
            </h3>
            <p class="experience__summary">{localize(experience.summary, locale)}</p>
            <ul class="experience__technologies">
              {experience.technologies.map((technology, technologyIndex) => (
                <TechHologram technology={technology} index={technologyIndex} compact />
              ))}
            </ul>
            <DetailToggle locale={locale} />
            <div class="experience__challenge step-detail">
              <p class="label label--accent">{dictionary.problem}</p>
              <p class="experience__problem">{localize(experience.challenge.problem, locale)}</p>
              <p class="label label--accent">{dictionary.approach}</p>
              <p>{localize(experience.challenge.approach, locale)}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</SectionShell>

<style>
  .experience {
    display: grid;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-line);
    transition: border-color var(--transition);
  }

  .experience:hover {
    border-top-color: var(--color-accent);
  }

  .experience__body {
    display: grid;
    gap: var(--space-2);
    max-width: 60ch;
  }

  .experience__role {
    font-size: 1.2rem;
  }

  .experience__company {
    display: block;
    margin-top: 0.3rem;
    font-size: var(--text-body);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-muted);
  }

  .experience__challenge {
    display: grid;
    gap: 0.3rem;
    padding-left: var(--space-2);
    border-left: 1px solid var(--color-accent);
  }

  .experience__problem {
    margin-bottom: var(--space-1);
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .experience__summary {
    color: var(--color-muted);
  }

  .experience__technologies {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) 0.25rem;
  }

  @container (min-width: 44rem) {
    .experience {
      grid-template-columns: 13rem 1fr;
    }
  }
</style>
